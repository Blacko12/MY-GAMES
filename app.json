{\n  "expo": {\n    "name": "ChatterBox",\n    "slug": "chatterbox",\n    "version": "1.0.0",\n    "orientation": "portrait",\n    "icon": "./assets/icon.png",\n    "splash": {\n      "image": "./assets/splash.png",\n      "resizeMode": "contain",\n      "backgroundColor": "#ffffff"\n    },\n    "updates": {\n      "fallbackToCacheTimeout": 0\n    },\n    "assetBundlePatterns": [\n      "**/*"\n    ],\n    "ios": {\n      "supportsTabletMode": true,\n      "bundleIdentifier": "com.blacko12.chatterbox"\n    },\n    "android": {\n      "adaptiveIcon": {\n        "foregroundImage": "./assets/adaptive-icon.png",\n        "backgroundColor": "#ffffff"\n      },\n      "package": "com.blacko12.chatterbox"\n    },\n    "web": {\n      "favicon": "./assets/favicon.png"\n    },\n    "plugins": [\n      [\n        "expo-notifications",\n        {\n          "icon": "./assets/notification-icon.png"\n        }\n      ],\n      "expo-camera",\n      "expo-contacts",\n      "expo-file-system"\n    ]\n  }\n}\n